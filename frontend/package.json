    "start": "ng serve",
    "prebuild": "node scripts/set-version.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "prestart:e2e": "node scripts/set-version.js",
    "start:e2e": "ng serve --configuration=e2e --port 4299",
    "test:e2e": "playwright test",
